# Copy to backend/.env and fill in.
# Neon/Supabase example: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://postgres:ARA2026@localhost:5432/dcas
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
FRONTEND_ORIGIN=http://localhost:5173

# web3-service (Node). Set WEB3_MOCK=true to develop without it.
WEB3_SERVICE_URL=http://localhost:3001
WEB3_SERVICE_KEY=dev-key
WEB3_MOCK=true

TSA_URL=https://freetsa.org/tsr
# mock | reality_defender
AI_PROVIDER=mock
REALITY_DEFENDER_API_KEY=...................
ANCHOR_INTERVAL_MINUTES=60
PHASH_MAX_DISTANCE=10
